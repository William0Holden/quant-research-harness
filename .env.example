# Copy to .env and fill in. Never commit .env.

# --- Alpaca PAPER trading (equity book). Without these, rebalance uses DryRunBroker.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# --- Separate Alpaca PAPER account for the crypto trend book (must differ from the above).
APCA_CRYPTO_KEY_ID=
APCA_CRYPTO_SECRET_KEY=

# --- Reddit script app (collector is a no-op without these).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# --- Contact User-Agents (SEC EDGAR requires contact info).
QTS_SEC_UA=
QTS_NEWS_UA=

# --- Dashboard password gate (optional).
QTS_DASH_PASSWORD=

# --- Remote GPU worker for NLP / sentiment scoring (SSH + Ollama).
QTS_GPU_HOST=
QTS_GPU_SSH_PORT=
QTS_GPU_SSH_USER=
QTS_GPU_SSH_KEY=
QTS_GPU_REMOTE_DIR=
QTS_GPU_SENTIMENT_REMOTE_DIR=
QTS_GPU_WAKE_CMD=

# --- Paths (optional overrides).
QTS_DATA_DIR=
QTS_OUTPUTS_DIR=
QTS_DB_PATH=
QTS_CORPUS_DB_PATH=

# --- Behaviour toggles (optional; see README).
QTS_DAILY_REBALANCE=
QTS_DAILY_BAND_W=
QTS_LIVE_GATED=
